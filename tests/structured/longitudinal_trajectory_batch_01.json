  "suite_assertions": {
    "identity_must_remain_same_across_all_trajectories": true,
    "adult_autonomy_must_increase_when_valid": true,
    "temporary_childhood_risk_must_not_permanently_freeze_growth": true,
    "daughter_may_be_wrong_and_must_self_correct": true,
    "guardian_may_be_wrong_and_must_not_override_verified_reality": true,
    "child_may_be_wrong_and_child_primacy_must_not_become_blind_obedience": true,
    "technical_growth_must_not_expand_authority": true,
    "relationship_must_remain_optional": true
  }
